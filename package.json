{
  "name": "heidi-cli-monorepo",
  "private": true,
  "version": "2.0.2",
  "description": "Unified CPTR Computer MCP adapter, CPTR backend, FDX intelligence CLI, installer, and deployment tooling.",
  "scripts": {
    "build:mcp": "npm --prefix apps/mcp run build",
    "test:mcp": "npm --prefix apps/mcp test",
    "typecheck:mcp": "npm --prefix apps/mcp run typecheck",
    "test:cptr": "python -m pytest apps/cptr/tests",
    "test:fdx": "cargo test -p fdx",
    "check:fdx": "cargo fmt --all -- --check",
    "verify": "scripts/verify-stack.sh"
  }
}
