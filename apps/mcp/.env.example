CPTR_BASE_URL=
CPTR_API_TOKEN=
MCP_ACCESS_TOKEN=
PUBLIC_ORIGIN=
# Comma-separated exact browser origins permitted to call MCP and Live Workbench endpoints.
MCP_ALLOWED_ORIGINS=
NODE_ENV=production
# Optional. Defaults to cloudflare-managed-oauth when Cloudflare Access is configured.
MCP_AUTH_MODE=
# Optional explicit OAuth authorization-server override. Managed OAuth derives this from PUBLIC_ORIGIN.
MCP_OAUTH_AUTHORIZATION_SERVER=
# Optional explicit OAuth resource override. Defaults to PUBLIC_ORIGIN + /mcp at runtime.
MCP_OAUTH_RESOURCE=
CLOUDFLARE_ACCESS_ISSUER=
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_ACCESS_JWKS_URI=
MCP_OAUTH_ALLOWED_EMAIL=
MCP_OAUTH_SCOPES=
HOST=
PORT=
