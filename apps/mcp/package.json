{
  "name": "chatgpt-computer-plugin",
  "private": true,
  "version": "2.1.7",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx server/index.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs && node scripts/check-workbench-bundle.mjs",
    "copy:web": "node scripts/copy-workbench-assets.mjs",
    "build:ui": "npm run build:web && npm run copy:web",
    "build:compat-ui": "npm run build:ui",
    "check:deployed-contract": "node scripts/check-deployed-contract.mjs",
    "build": "npm run build:server && npm run build:ui",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "jose": "^6.2.10",
    "js-tiktoken": "^1.0.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
